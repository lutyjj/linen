{
    "name": "linen",
    "private": true,
    "version": "0.9.0",
    "type": "module",
    "description": "A calm design language for React apps: tokens, motion, and the components that wear them.",
    "license": "MIT",
    "packageManager": "pnpm@12.9.0",
    "exports": {
        ".": "./src/index.ts",
        "./react-router": "./src/navigation/react-router.tsx",
        "./still": "./src/still/still.tsx",
        "./package.json": "./package.json",
        "./linen.css": "./src/styles/linen.css"
    },
    "files": [
        "dist"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "publishConfig": {
        "exports": {
            ".": "./dist/index.js",
            "./react-router": "./dist/react-router.js",
            "./still": "./dist/still.js",
            "./package.json": "./package.json",
            "./linen.css": "./dist/styles/linen.css"
        }
    },
    "scripts": {
        "specimen": "vite",
        "specimen:still": "vite --mode still",
        "specimen:preact": "vite --mode preact",
        "build": "tsdown",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "check": "pnpm run build && prettier --check . && eslint . && tsc --noEmit && tsc -p consumer && tsc -p consumer/tsconfig.strict.json && vitest run && vite build && vite build --mode still && vite build --mode preact && vite build --config consumer/vite.config.ts --mode minimal && vite build --config consumer/vite.config.ts --mode app",
        "format": "prettier --write ."
    },
    "dependencies": {
        "tailwind-merge": "^3.7.0"
    },
    "peerDependencies": {
        "@base-ui/react": "^1.9.0",
        "lucide-react": "^1.68.0",
        "motion": "^14.10.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^8.5.1",
        "tailwindcss": "^4.3.4"
    },
    "peerDependenciesMeta": {
        "motion": {
            "optional": true
        },
        "react-router": {
            "optional": true
        }
    },
    "devDependencies": {
        "@arethetypeswrong/core": "^0.18.5",
        "@base-ui/react": "^1.9.0",
        "@eslint/js": "^10.0.1",
        "@preact/preset-vite": "^2.10.6",
        "@tailwindcss/vite": "^4.3.4",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "globals": "^17.13.0",
        "jsdom": "^30.1.3",
        "lucide-react": "^1.68.0",
        "motion": "^14.10.0",
        "preact": "^11.2.0",
        "prettier": "^3.9.10",
        "publint": "^0.3.25",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^8.5.1",
        "tailwindcss": "^4.3.4",
        "tsdown": "^0.23.7",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.6",
        "vitest": "^5.1.0"
    }
}
