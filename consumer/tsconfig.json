{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "types": [],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": false,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "paths": {
            "linen": ["../dist/index.d.ts"],
            "linen/still": ["../dist/still.d.ts"]
        }
    },
    "include": ["*.tsx"]
}
